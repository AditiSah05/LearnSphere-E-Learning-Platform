PORT=5000
JWT_SECRET=change_this_secret

# Password reset emails (Gmail SMTP). EMAIL_PASS must be a 16-character
# App Password from https://myaccount.google.com/apppasswords, not your
# regular Gmail password.
EMAIL_USER=
EMAIL_PASS=

# Base URL the frontend is served from — used to build the reset link
# sent in the email.
FRONTEND_URL=http://localhost:8080
